      ]
    },
    {
      "id": "data_nascimento",
      "nome": "Data de nascimento",
      "categoria": "identificador",
      "lgpd": "Art. 5º, I — dado pessoal",
      "severidade": "media",
      "padrao": "(?i:nasc\\w*|data de nascimento|\\bdn\\b)[\"']?\\W{0,15}(\\d{2}/\\d{2}/\\d{4}|\\d{4}-\\d{2}-\\d{2})"
    },
    {
      "id": "cartao_credito",
      "nome": "Cartão de crédito",
      "categoria": "financeiro",
      "lgpd": "Art. 5º, I — dado pessoal (financeiro)",
      "severidade": "alta",
      "padrao": "(?<![\\d.\\-])(\\d{4}[ \\-]?\\d{4}[ \\-]?\\d{4}[ \\-]?\\d{4})(?![\\d\\-])",
      "validador": "luhn"
    },
    {
      "id": "senha_atribuida",
      "nome": "Senha ou token em texto",
      "categoria": "credencial",
      "lgpd": "Art. 46 — segurança dos dados (credencial de acesso)",
      "severidade": "critica",
      "padrao": "(?i:\\b(?:senha|password|passwd|pwd|secret|segredo|api[_\\-]?key|access[_\\-]?key|token)\\b)[\"']?\\s*[:=]\\s*[\"']?([^\\s\"',;)}\\]]{4,})",
      "validador": "segredo"
    },
    {
