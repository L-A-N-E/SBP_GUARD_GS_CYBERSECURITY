          "portadora",
          "diagnosticado",
          "diagnosticada",
          "diagnostico",
          "laudo",
          "cid",
          "prontuario"
        ],
        "janela": 80,
        "obrigatorio": true,
        "aceita_identificador_proximo": true
      }
    },
    {
      "id": "email",
      "nome": "E-mail",
      "categoria": "contato",
      "lgpd": "Art. 5º, I — dado pessoal",
      "severidade": "media",
      "padrao": "\\b([A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,})\\b",
      "ignorar": [
        "@example\\.",
        "@exemplo\\.",
        "noreply@",
        "@anthropic\\.com",
        "@users\\.noreply\\.github\\.com"
      ]
    },
    {
      "id": "telefone",
      "nome": "Telefone celular",
      "categoria": "contato",
      "lgpd": "Art. 5º, I — dado pessoal",
      "severidade": "media",
      "padrao": "(?<![\\d.\\-])((?:\\+?55\\s?)?\\(?[1-9]{2}\\)?\\s?9\\d{4}[\\-\\s]?\\d{4})(?![\\d\\-]|\\.\\d)"
    },
    {
      "id": "nome_rotulado",
      "nome": "Nome de pessoa",
      "categoria": "identificador",
      "lgpd": "Art. 5º, I — dado pessoal",
      "severidade": "media",
      "padrao": "(?i:\\b(?:nome(?:_completo)?|paciente|passageir[oa]|cidad[aã]o)\\b)[\"']?\\s*[:=]\\s*[\"']?([A-ZÀ-Ý][a-zà-ÿ]+(?:\\s+(?:d[aeo]s?\\s+)?[A-ZÀ-Ý][a-zà-ÿ]+)+)",
      "contexto": {
