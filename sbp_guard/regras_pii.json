{
  "_sobre": "Regras do motor de parsing PII do SBP Guard. Para criar uma regra nova basta adicionar um item em 'regras' (texto) ou 'chaves' (campos de JSON/.env). Validadores disponiveis: cpf, cns, luhn, segredo, nenhum.",
  "regras": [
    {
      "id": "cpf",
      "nome": "CPF",
      "categoria": "identificador",
      "lgpd": "Art. 5º, I — dado pessoal",
      "severidade": "alta",
      "padrao": "(?<![\\d.\\-/])(\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2})(?![\\d\\-/]|\\.\\d)",
      "validador": "cpf"
    },
    {
      "id": "rg",
      "nome": "RG",
      "categoria": "identificador",
      "lgpd": "Art. 5º, I — dado pessoal",
      "severidade": "alta",
      "padrao": "(?i:\\b(?:rg|r\\.g\\.|registro geral)\\b)[\\s:nº.]{0,6}(\\d{1,2}\\.?\\d{3}\\.?\\d{3}-?[\\dxX])(?!\\d)"
    },
    {
      "id": "cartao_sus",
      "nome": "Cartão Nacional de Saúde (CNS)",
      "categoria": "saude",
      "lgpd": "Art. 11 — dado pessoal sensível (saúde)",
      "severidade": "alta",
      "padrao": "(?<![\\d.\\-])([1-2789]\\d{2}[ .]?\\d{4}[ .]?\\d{4}[ .]?\\d{4})(?![\\d\\-]|\\.\\d)",
      "validador": "cns"
    },
    {
      "id": "cid10",
      "nome": "Código de doença (CID-10)",
      "categoria": "saude",
      "lgpd": "Art. 11 — dado pessoal sensível (saúde)",
      "severidade": "alta",
      "padrao": "\\b([A-TV-Z][0-9]{2}(?:\\.[0-9A-Z]{1,2})?)\\b",
