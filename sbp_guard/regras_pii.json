        "palavras": [
          "cid",
          "cid-10",
          "cid10",
          "diagnostico",
          "laudo",
          "prontuario",
          "doenca"
        ],
        "janela": 40,
        "obrigatorio": true
      }
    },
    {
      "id": "condicao_saude",
      "nome": "Condição de saúde ou deficiência",
      "categoria": "saude",
      "lgpd": "Art. 11 — dado pessoal sensível (saúde)",
      "severidade": "alta",
      "padrao": "(?i)\\b(deficiencia (?:visual|auditiva|fisica|intelectual|motora|multipla)|cegueira|baixa visao|cadeirante|surdez|surd[oa]|autismo|autista|epilepsia|diabetes|diabetic[oa]|hiv|soropositiv[oa]|esquizofrenia|depressao|mobilidade reduzida|gestante)\\b",
      "contexto": {
